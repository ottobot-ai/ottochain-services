{
  "name": "ottochain-services",
  "version": "1.0.2",
  "private": true,
  "description": "OttoChain companion services - Gateway, Bridge, Indexer",
  "repository": {
    "type": "git",
    "url": "https://github.com/ottobot-ai/ottochain-services"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:integration": "./scripts/integration-test.sh",
    "test:e2e": "tsx scripts/scenarios/multi-agent-sim.ts",
    "test:webhook": "tsx scripts/test-webhook.ts",
    "test:rejection-api": "tsx scripts/testing/test-rejection-api.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "prisma": "^7.6.0",
    "tsx": "^4.7.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@ottochain/sdk": "2.2.5",
    "@prisma/client": "^7.5.0",
    "ioredis": "^5.10.0"
  },
  "pnpm": {
    "overrides": {
      "@types/express-serve-static-core": ">=5.0.0"
    }
  }
}
