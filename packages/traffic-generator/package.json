{
  "name": "@ottochain/traffic-generator",
  "version": "0.1.0",
  "description": "Evolutionary traffic generator for OttoChain metagraph",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ottochain/sdk": "2.4.0",
    "@ottochain/shared": "workspace:*",
    "@stardust-collective/dag4": "^2.8.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4.7.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
