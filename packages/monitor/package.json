{
  "name": "@ottochain/monitor",
  "version": "0.1.0",
  "description": "OttoChain stack monitoring service with dashboard UI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/*.html dist/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ottochain/shared": "workspace:*",
