    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "ioredis": "^5.9.3",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
